{
  "schema_version": 1,
  "x-relationships": {
    "implements": [
      "package-repository-publishing"
    ]
  },
  "products": {
    "wyrwood": {
      "source_repository": "wyrd-company/wyrwood",
      "package": {
        "name": "wyrwood",
        "binary": "wyrwood",
        "description": "Filtered SSH-agent endpoints for containers",
        "homepage": "https://github.com/wyrd-company/wyrwood",
        "license": "Apache-2.0",
        "maintainer": "Wyrd Company <support@wyrd.company>"
      },
      "publish": {
        "apt": {
          "suite": "stable",
          "component": "main"
        },
        "rpm": {
          "channel": "stable"
        },
        "aur": {
          "package": "wyrwood-bin",
          "installation": {
            "files": {
              "packaging/wyrwood-agent.service": "/usr/lib/systemd/system/wyrwood-agent.service",
              "packaging/wyrwood-engine-proxy.service": "/usr/lib/systemd/system/wyrwood-engine-proxy.service",
              "packaging/wyrwood.tmpfiles": "/usr/lib/tmpfiles.d/wyrwood.conf",
              "packaging/preinstall.sh": "/usr/lib/wyrwood/preinstall.sh",
              "packaging/wyrwood-engine-upgrade.hook": "/usr/share/libalpm/hooks/wyrwood-engine-upgrade.hook"
            },
            "hooks": {
              "pre-install": "packaging/preinstall.sh",
              "post-install": "packaging/postinstall.sh",
              "pre-remove": "packaging/preremove.sh",
              "post-remove": "packaging/postremove.sh"
            }
          }
        }
      }
    },
    "toha": {
      "source_repository": "wyrd-company/toha",
      "package": {
        "name": "toha",
        "binary": "toha",
        "description": "Generate projects and files from templates",
        "homepage": "https://github.com/wyrd-company/toha",
        "license": "Apache-2.0",
        "maintainer": "Wyrd Company <support@wyrd.company>"
      },
      "publish": {
        "apt": {
          "suite": "stable",
          "component": "main"
        },
        "rpm": {
          "channel": "stable"
        },
        "aur": {
          "package": "toha-bin"
        }
      }
    },
    "trowel": {
      "source_repository": "wyrd-company/trowel",
      "package": {
        "name": "trowel",
        "binary": "trowel",
        "description": "Relay HTTP webhooks into NATS JetStream and JetStream messages out to HTTP or commands",
        "homepage": "https://github.com/wyrd-company/trowel",
        "license": "Apache-2.0",
        "maintainer": "Wyrd Company <support@wyrd.company>"
      },
      "publish": {
        "apt": {
          "suite": "stable",
          "component": "main"
        },
        "rpm": {
          "channel": "stable"
        },
        "aur": {
          "package": "trowel-bin",
          "installation": {
            "files": {
              "packaging/trowel.service": "/usr/lib/systemd/system/trowel.service"
            },
            "hooks": {
              "pre-install": "packaging/preinstall.sh",
              "post-install": "packaging/postinstall.sh",
              "pre-remove": "packaging/preremove.sh",
              "post-remove": "packaging/postremove.sh"
            }
          }
        }
      }
    },
    "dcb": {
      "source_repository": "wyrd-company/devcontainer-builder",
      "package": {
        "name": "dcb",
        "binary": "dcb",
        "description": "Build and run development containers",
        "homepage": "https://github.com/wyrd-company/devcontainer-builder",
        "license": "MIT",
        "maintainer": "Wyrd Company <support@wyrd.company>"
      },
      "publish": {
        "apt": {
          "suite": "stable",
          "component": "main"
        },
        "rpm": {
          "channel": "stable"
        },
        "aur": {
          "package": "dcb-bin"
        }
      }
    }
  }
}
